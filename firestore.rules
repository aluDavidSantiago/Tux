rules_version = '2';

// Reglas de seguridad de Tux.
// Colecciones: users (+ history), activities (+ comments), likes, saved, proofs, notifications, admins,
// follows, chats (+ messages), config, userAvatars (mascota), reports y disabledUsers.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    // Admin = existe admins/{uid}. Esa colección solo se escribe desde la consola de Firebase.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Cuenta activa: con sesión y sin disabledUsers/{uid} (lo crea un admin al desactivar o eliminar).
    function active() {
      return signedIn() && !exists(/databases/$(database)/documents/disabledUsers/$(request.auth.uid));
    }
    function activityPath(id) { return /databases/$(database)/documents/activities/$(id); }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function counter(d, key) { return d.get(key, 0); }

    // ---------- Perfiles ----------
    function validPrefs(p) {
      return p is map
        && p.keys().hasOnly(['frequencyDays', 'interests', 'maxBudget', 'maxEffort'])
        && p.frequencyDays in [1, 2, 3, 7]
        && p.interests is list && p.interests.size() <= 5
        && p.maxBudget in ['free', 'low', 'mid', 'high']
        && p.maxEffort in ['low', 'mid', 'high'];
    }

    function validStar(s) {
      return s == null || (s is map
        && s.keys().hasOnly(['activityId', 'period', 'frequencyDays'])
        && s.activityId is string && s.activityId.size() <= 128
        && s.period is int
        && s.frequencyDays in [1, 2, 3, 7]);
    }

    // nickname y createdAt son obligatorios; el resto es opcional pero se valida si existe.
    function validUser(d) {
      return d.keys().hasOnly(['nickname', 'photoURL', 'avatarColor', 'bio', 'prefs', 'star',
                               'followersCount', 'followingCount', 'createdAt'])
        && counter(d, 'followersCount') is int && counter(d, 'followersCount') >= 0
        && counter(d, 'followingCount') is int && counter(d, 'followingCount') >= 0
        && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 24
        && (!('bio' in d) || (d.bio is string && d.bio.size() <= 160))
        // Foto: URL https o la foto recortada del propio usuario en el HDD (avatar.jpg?v=marca).
        && (!('photoURL' in d) || (d.photoURL is string && d.photoURL.size() <= 500
          && (d.photoURL == '' || d.photoURL.matches('https://.+')
            || d.photoURL.matches('local:users/' + request.auth.uid + '/avatar[.]jpg([?]v=[0-9]{1,16})?'))))
        && (!('avatarColor' in d) || d.avatarColor in ['orange', 'ice', 'mint', 'lilac', 'night'])
        && (!('prefs' in d) || validPrefs(d.prefs))
        && (!('star' in d) || validStar(d.star));
    }

    // Referencia multimedia: archivo del HDD (servidor de Tux) en la carpeta del PROPIO usuario.
    function mediaRef(u) {
      return u is string && u.size() <= 500
        && u.matches('local:users/' + request.auth.uid + '/[0-9a-f-]{36}([.]thumb)?[.](jpg|png|mp4)');
    }
    function optionalMediaRef(u) { return u == '' || mediaRef(u); }

    // Historial: completar exige prueba multimedia; descartar exige justificación.
    function validHistory(d, id) {
      return d.keys().hasOnly(['activityId', 'status', 'title', 'category', 'emoji', 'imageUrl',
                               'reason', 'note', 'proofId', 'proofUrl', 'proofThumb', 'proofType', 'is360', 'updatedAt'])
        && d.activityId == id
        && d.status in ['accepted', 'completed', 'discarded']
        && d.title is string && d.title.size() <= 80
        && d.imageUrl is string && d.imageUrl.size() <= 500
        && d.updatedAt == request.time
        && (!('note' in d) || (d.note is string && d.note.size() <= 280))
        && (d.status != 'discarded' || (d.reason is string && d.reason.size() >= 3 && d.reason.size() <= 80))
        && (!('proofThumb' in d) || optionalMediaRef(d.proofThumb))
        && (d.status != 'completed' || (mediaRef(d.proofUrl) && d.proofId is string
                                        && d.proofType in ['image', 'video'] && d.is360 is bool));
    }

    // Contadores de seguidores: solo cambian ±1 junto a la relación follows/{seguidor}_follows_{seguido}.
    function followPath(followerUid, targetUid) {
      return /databases/$(database)/documents/follows/$(followerUid + '_follows_' + targetUid);
    }
    function followCountersUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount', 'followingCount']);
    }
    // "Siguiendo" del propio perfil (la regla de follows exige este mismo cambio en el batch).
    function validFollowingChange() {
      let delta = counter(request.resource.data, 'followingCount') - counter(resource.data, 'followingCount');
      return onlyChanged(['followingCount']) && (delta == 1 || delta == -1);
    }
    // "Seguidores" de otro usuario: +1 solo si a la vez se crea mi relación con él, -1 si se borra.
    function validFollowersChange(uid) {
      let p = followPath(request.auth.uid, uid);
      let delta = counter(request.resource.data, 'followersCount') - counter(resource.data, 'followersCount');
      return onlyChanged(['followersCount'])
        && ((delta == 1 && !exists(p) && existsAfter(p)) || (delta == -1 && exists(p) && !existsAfter(p)));
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isUser(uid) && active() && validUser(request.resource.data)
        && counter(request.resource.data, 'followersCount') == 0
        && counter(request.resource.data, 'followingCount') == 0
        && request.resource.data.createdAt == request.time;
      allow update: if (isUser(uid) && active() && validUser(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && (followCountersUnchanged() || validFollowingChange()))
        || (active() && !isUser(uid) && validFollowersChange(uid)
          && counter(request.resource.data, 'followersCount') >= 0)
        // Admin: al eliminar una cuenta se descuentan los contadores de sus seguidores/seguidos.
        || (isAdmin() && onlyChanged(['followersCount', 'followingCount'])
          && counter(request.resource.data, 'followersCount') >= 0
          && counter(request.resource.data, 'followingCount') >= 0);
      allow delete: if isAdmin();

      match /history/{activityId} {
        allow read, delete: if isUser(uid) || isAdmin();
        allow create: if isUser(uid) && validHistory(request.resource.data, activityId);
        // El admin solo puede devolver un plan a "en curso" (al quitar una prueba no válida).
        allow update: if (isUser(uid) && validHistory(request.resource.data, activityId))
          || (isAdmin() && request.resource.data.status == 'accepted' && validHistory(request.resource.data, activityId));
      }
    }

    // ---------- Planes ----------
    function validActivity(d) {
      return d.keys().hasOnly(['title', 'description', 'emoji', 'imageUrl', 'category', 'budget',
                               'effort', 'when', 'duration', 'authorId', 'authorName',
                               'likeCount', 'commentCount', 'createdAt', 'seed'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 280
        && d.emoji is string && d.emoji.size() <= 16
        && d.imageUrl is string && d.imageUrl.size() <= 500
        && (d.imageUrl == '' || d.imageUrl.matches('https://.+'))
        && d.category in ['chill', 'aventura', 'gastronomia', 'cultura', 'nocturno']
        && d.budget in ['free', 'low', 'mid', 'high']
        && d.effort in ['low', 'mid', 'high']
        && d.when in ['day', 'night', 'weekend']
        && d.duration in ['15 min', '30 min', '1 h', '2 h', 'Medio día']
        && d.authorName is string && d.authorName.size() <= 24
        && (!('seed' in d) || d.seed is bool);
    }

    // +1/-1 en likeCount solo si el doc likes/{uid}_{id} se crea/borra en el mismo batch.
    function validLikeChange(id) {
      let likePath = /databases/$(database)/documents/likes/$(request.auth.uid + '_' + id);
      let delta = request.resource.data.likeCount - resource.data.likeCount;
      return onlyChanged(['likeCount'])
        && ((delta == 1 && !exists(likePath) && existsAfter(likePath))
          || (delta == -1 && exists(likePath) && !existsAfter(likePath)));
    }

    function validCommentCountChange() {
      let delta = request.resource.data.commentCount - resource.data.commentCount;
      return onlyChanged(['commentCount']) && (delta == 1 || delta == -1)
        && request.resource.data.commentCount >= 0;
    }

    match /activities/{id} {
      allow read: if true;
      allow create: if active() && validActivity(request.resource.data)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (validLikeChange(id) || validCommentCountChange());
      allow delete: if isUser(resource.data.authorId) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if active()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 24
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && getAfter(activityPath(id)).data.commentCount == get(activityPath(id)).data.commentCount + 1;
        allow delete: if signedIn()
          && (resource.data.authorId == request.auth.uid
            || get(activityPath(id)).data.authorId == request.auth.uid)
          && getAfter(activityPath(id)).data.commentCount == get(activityPath(id)).data.commentCount - 1;
        // Limpieza en cascada (plan ya borrado o cuenta eliminada): sin tocar contadores.
        allow delete: if isAdmin();
      }
    }

    // ---------- Relaciones usuario ↔ plan ----------
    function validRelation(relId) {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(['uid', 'activityId', 'createdAt'])
        && d.uid == request.auth.uid
        && d.activityId is string
        && relId == request.auth.uid + '_' + d.activityId
        && d.createdAt == request.time;
    }

    match /likes/{likeId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
      allow create: if validRelation(likeId)
        && getAfter(activityPath(request.resource.data.activityId)).data.likeCount
          == get(activityPath(request.resource.data.activityId)).data.likeCount + 1;
      // Si el plan ya no existe, el like huérfano se puede borrar sin tocar contadores.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!exists(activityPath(resource.data.activityId))
          || getAfter(activityPath(resource.data.activityId)).data.likeCount
            == get(activityPath(resource.data.activityId)).data.likeCount - 1);
    }

    match /saved/{savedId} {
      allow read, delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create, update: if active() && validRelation(savedId);
    }

    // ---------- Pruebas multimedia (Galería VR) ----------
    // Portada 360°: ángulo inicial (grados) con el que se muestra la publicación.
    function validCover(c) {
      return c is map && c.keys().hasOnly(['yaw', 'pitch', 'fov'])
        && c.yaw is number && c.yaw >= -180 && c.yaw <= 180
        && c.pitch is number && c.pitch >= -90 && c.pitch <= 90
        && c.fov is number && c.fov >= 30 && c.fov <= 120;
    }

    match /proofs/{proofId} {
      allow read: if true;
      allow update: if active() && resource.data.uid == request.auth.uid
        && onlyChanged(['cover']) && validCover(request.resource.data.cover);
      allow create: if active()
        && request.resource.data.keys().hasOnly(['uid', 'authorName', 'activityId', 'activityTitle', 'url',
                                                 'thumbUrl', 'type', 'is360', 'width', 'height', 'caption', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && mediaRef(request.resource.data.url)
        && optionalMediaRef(request.resource.data.thumbUrl)
        && request.resource.data.type in ['image', 'video']
        && request.resource.data.is360 is bool
        && request.resource.data.width is int && request.resource.data.height is int
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 200
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 24
        && request.resource.data.activityId is string
        && request.resource.data.activityTitle is string && request.resource.data.activityTitle.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // ---------- Notificaciones (las envían los admins) ----------
    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['toUid', 'title', 'body', 'kind', 'read', 'fromName', 'createdAt'])
        && request.resource.data.toUid is string && request.resource.data.toUid.size() <= 128
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 1000
        && request.resource.data.kind in ['info', '360', 'warning']
        && request.resource.data.read == false
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.toUid == request.auth.uid
        && onlyChanged(['read']) && request.resource.data.read is bool;
      allow delete: if signedIn() && (resource.data.toUid == request.auth.uid || isAdmin());
    }

    // ---------- Seguidores ----------
    // follows/{followerUid}_follows_{targetUid}: públicos (listas de seguidores en los perfiles).
    match /follows/{followId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['followerUid', 'targetUid', 'createdAt'])
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && followId == request.auth.uid + '_follows_' + request.resource.data.targetUid
        && request.resource.data.createdAt == request.time
        && counter(getAfter(userPath(request.auth.uid)).data, 'followingCount')
          == counter(get(userPath(request.auth.uid)).data, 'followingCount') + 1
        && counter(getAfter(userPath(request.resource.data.targetUid)).data, 'followersCount')
          == counter(get(userPath(request.resource.data.targetUid)).data, 'followersCount') + 1;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid
        && counter(getAfter(userPath(request.auth.uid)).data, 'followingCount')
          == counter(get(userPath(request.auth.uid)).data, 'followingCount') - 1
        && counter(getAfter(userPath(resource.data.targetUid)).data, 'followersCount')
          == counter(get(userPath(resource.data.targetUid)).data, 'followersCount') - 1;
    }

    // ---------- Mensajería privada ----------
    // chats/{uidA}_{uidB} con los uids ordenados: la pertenencia se deduce del propio ID.
    function chatMember(chatId) { return signedIn() && request.auth.uid in chatId.split('_'); }
    function chatPath(chatId) { return /databases/$(database)/documents/chats/$(chatId); }
    function validLastMessage(m) {
      return m is map && m.keys().hasOnly(['text', 'senderId', 'createdAt'])
        && m.text is string && m.text.size() >= 1 && m.text.size() <= 140
        && m.senderId == request.auth.uid
        && m.createdAt == request.time;
    }
    // Respuesta a una publicación: miniatura solo como referencia a una imagen del HDD.
    function validReply(r) {
      return r is map && r.keys().hasOnly(['proofId', 'title', 'thumb'])
        && r.proofId is string && r.proofId.size() <= 128
        && r.title is string && r.title.size() <= 80
        && r.thumb is string
        && (r.thumb == '' || r.thumb.matches('local:users/[A-Za-z0-9]+/[0-9a-f-]{36}([.]thumb)?[.](jpg|png)'));
    }

    match /chats/{chatId} {
      allow get: if chatMember(chatId) || isAdmin();
      allow list: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      allow create: if chatMember(chatId) && active()
        && request.resource.data.keys().hasOnly(['members', 'lastMessage', 'updatedAt', 'lastRead'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(userPath(request.resource.data.members[0]))
        && exists(userPath(request.resource.data.members[1]))
        && validLastMessage(request.resource.data.lastMessage)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastRead.keys().hasOnly([request.auth.uid]);
      // Enviar (último mensaje) o marcar como leído: cada uno solo toca su propia marca de lectura.
      allow update: if chatMember(chatId) && active()
        && request.resource.data.members == resource.data.members
        && onlyChanged(['lastMessage', 'updatedAt', 'lastRead'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'updatedAt'])
          || (validLastMessage(request.resource.data.lastMessage) && request.resource.data.updatedAt == request.time))
        && request.resource.data.lastRead.diff(resource.data.get('lastRead', {})).affectedKeys().hasOnly([request.auth.uid]);
      // Solo al eliminar una cuenta (el admin borra antes los mensajes).
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if chatMember(chatId) || isAdmin();
        allow create: if chatMember(chatId) && active()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'replyTo'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && (!('replyTo' in request.resource.data) || validReply(request.resource.data.replyTo))
          && getAfter(chatPath(chatId)).data.updatedAt == request.time;
        allow update: if false;
        allow delete: if (chatMember(chatId) && resource.data.senderId == request.auth.uid) || isAdmin();
      }
    }

    // ---------- Configuración pública (URL del servidor multimedia / túnel) ----------
    match /config/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && docId == 'media'
        && request.resource.data.keys().hasOnly(['serverUrl', 'updatedBy', 'updatedAt'])
        && request.resource.data.serverUrl is string
        && request.resource.data.serverUrl.size() <= 200
        && (request.resource.data.serverUrl.matches('https://[A-Za-z0-9.-]+(:[0-9]+)?')
          || request.resource.data.serverUrl.matches('http://(localhost|127[.]0[.]0[.]1)(:[0-9]+)?'))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // ---------- Mascota Tux personalizable ----------
    // userAvatars/{uid}: ítems equipados por hueco y lista de desbloqueados (cosmético).
    function itemIn(v, ids) { return v is string && (v == '' || v in ids); }
    function validMascot(d) {
      return d.keys().hasOnly(['equipped', 'unlocked', 'updatedAt'])
        && d.equipped is map && d.equipped.keys().hasOnly(['hat', 'outfit', 'accessory', 'background'])
        && itemIn(d.equipped.get('hat', ''), ['cap', 'beanie', 'party', 'crown'])
        && itemIn(d.equipped.get('outfit', ''), ['scarf', 'bowtie', 'tshirt', 'medal'])
        && itemIn(d.equipped.get('accessory', ''), ['sunglasses', 'flower', 'headphones', 'vr', 'camera'])
        && itemIn(d.equipped.get('background', ''), ['ice', 'sunset', 'night', 'aurora'])
        && d.unlocked is list && d.unlocked.size() <= 40
        && d.updatedAt == request.time;
    }

    match /userAvatars/{uid} {
      allow read: if true;
      allow create, update: if isUser(uid) && active() && validMascot(request.resource.data);
      allow delete: if isUser(uid) || isAdmin();
    }

    // ---------- Publicaciones reportadas ----------
    // reports/{proofId}_{reporterUid}: un reporte por usuario y publicación. Solo los admins los ven.
    match /reports/{reportId} {
      allow read, delete: if isAdmin();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['proofId', 'proofUid', 'activityTitle', 'reporterUid', 'reason', 'note', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.proofId is string
        && reportId == request.resource.data.proofId + '_' + request.auth.uid
        && request.resource.data.proofUid == get(/databases/$(database)/documents/proofs/$(request.resource.data.proofId)).data.uid
        && request.resource.data.proofUid != request.auth.uid
        && request.resource.data.activityTitle is string && request.resource.data.activityTitle.size() <= 80
        && request.resource.data.reason in ['inappropriate', 'spam', 'fake', 'privacy', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 280
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // ---------- Cuentas desactivadas / eliminadas ----------
    match /disabledUsers/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create, update: if isAdmin() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['reason', 'deleted', 'disabledBy', 'nickname', 'createdAt'])
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 200
        && request.resource.data.deleted is bool
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 24
        && request.resource.data.disabledBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    // ---------- Admins (solo lectura del propio documento) ----------
    match /admins/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }
  }
}
